# -----------------------------------------------------------------------------
# ACAL Intelligence — environment template
# Copy to .env and fill only the values you have.
# Never commit real secrets. Never expose these values to the browser.
# -----------------------------------------------------------------------------

# PostgreSQL (Supabase development). Leave empty to run the dashboard in memory.
# Example (Supabase): postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Direct connection used by Prisma migrations (Supabase port 5432).
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
DIRECT_URL=

# OpenAI — optional. If empty, MockAIProvider is used.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Z-API — reserved for a future WhatsApp integration.
# Do not send real messages in this MVP.
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Login da tela pública. Obrigatório na Vercel.
AUTH_USERNAME=acal
AUTH_PASSWORD=
AUTH_SECRET=

# Runtime mode
MOCK_MODE=true
DATA_SOURCE_PROVIDER=mock
AI_PROVIDER=mock
MESSAGING_PROVIDER=mock
